# V5 must use a dedicated non-production Supabase project.
VITE_APP_ENV=v5-development
VITE_APP_BASE=/Analytics/v5/
VITE_SUPABASE_URL=https://your-v5-project.supabase.co
# The legacy variable name is kept by the frontend; put the modern publishable key here.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-v5-key
# Explicit opt-in: only v5-development may read the Market page from V5 RPC.
VITE_V5_MARKET_BACKEND_ENABLED=false

# Supabase direct DB connection (KEEP SECRET — never commit or share)
# SUPABASE_CONNECTION_STRING=postgresql://user:password@host:5432/postgres
